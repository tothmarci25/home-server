#!/usr/bin/env python3
# Managed by Ansible role: cloudflare_ddns — do not edit on the host.
import os

import requests
from CloudFlare import CloudFlare

# === CONFIGURATION ===
# API token is injected via the systemd unit's environment (see cloudflare-ddns.service),
# so it is never written to disk in this script.
API_TOKEN = os.environ["CLOUDFLARE_DDNS_API_TOKEN"]
ZONE_NAME = "{{ cloudflare_ddns_zone_name }}"        # Your domain
DNS_NAMES = [                                        # Full records to update
{% for name in cloudflare_ddns_record_names %}
    "{{ name }}",
{% endfor %}
]
TTL = {{ cloudflare_ddns_ttl }}                      # Time-to-live in seconds
PROXIED = {{ 'True' if cloudflare_ddns_proxied else 'False' }}  # False = grey cloud (DNS only), True = orange cloud (proxied)


# === FUNCTIONS ===
def get_public_ip():
    urls = [
        "https://ipv4.icanhazip.com",
        "https://api.ipify.org",
        "https://ifconfig.me/ip"
    ]

    for url in urls:
        try:
            response = requests.get(url, timeout=(5, 5))
            response.raise_for_status()
            return response.text.strip()
        except Exception as e:
            print(f"❌ Error using {url}: {e}")

    # If everything failed
    return None


def update_record(cf, zone_id, dns_name, ip):
    """Create-or-update a single A record to point at ip. One record's failure
    must not block the others, so exceptions are caught and logged here."""
    try:
        records = cf.zones.dns_records.get(zone_id, params={"name": dns_name})
        if not records:
            print(f"❌ DNS record {dns_name} not found. Please create it manually first.")
            return

        record = records[0]
        record_id = record["id"]
        old_ip = record["content"]

        if old_ip == ip:
            print(f"✅ {dns_name} already up to date ({ip})")
            return

        cf.zones.dns_records.put(zone_id, record_id, data={
            "type": "A",
            "name": dns_name,
            "content": ip,
            "ttl": TTL,
            "proxied": PROXIED
        })

        print(f"🔁 Updated {dns_name} from {old_ip} → {ip}")

    except Exception as e:
        print(f"❌ Error updating {dns_name}: {e}")


def main():
  try:
    cf = CloudFlare(token=API_TOKEN)
    ip = get_public_ip()
    if not ip:
        return

    try:
        # Find Zone ID (shared by every record in the zone)
        zones = cf.zones.get(params={"name": ZONE_NAME})
        if not zones:
            print(f"❌ Zone {ZONE_NAME} not found in Cloudflare account.")
            return
        zone_id = zones[0]["id"]

        # Point every managed record at the current public IP.
        for dns_name in DNS_NAMES:
            update_record(cf, zone_id, dns_name, ip)

    except Exception as e:
        print(f"❌ Error updating Cloudflare records: {e}")

  except Exception as e:
        print(f"🔥 FATAL ERROR in main(): {e}")


if __name__ == "__main__":
    main()
